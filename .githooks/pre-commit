#!/usr/bin/env bash
# ==============================================================================
# Govi Clean Architecture Template - Pre-Commit Git Hook
# Enforces:
#  1. Auto-formatting via Spotless (ktlint)
#  2. Re-staging of formatted files
#  3. Zero-Warning Policy (-Werror / allWarningsAsErrors)
# ==============================================================================

set -e

echo ""
echo "=========================================================="
echo " 🚀 [Pre-Commit Hook] Starting automated quality checks... "
echo "=========================================================="

# Automatically detect JAVA_HOME on macOS if not already defined in environment
if [ -z "$JAVA_HOME" ]; then
    if [ -d "/Applications/Android Studio.app/Contents/jbr/Contents/Home" ]; then
        export JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
    elif [ -x "/usr/libexec/java_home" ]; then
        export JAVA_HOME=$(/usr/libexec/java_home 2>/dev/null || true)
    fi
fi

# Step 1: Auto-format all modified code using Spotless (ktlint)
echo "🧹 Step 1/3: Running Spotless code auto-formatting..."
./gradlew spotlessApply --daemon -q

# Step 2: Re-stage files that were modified by the auto-formatter
echo "📦 Step 2/3: Re-staging auto-formatted files..."
# Re-stage only files that were already staged in this commit and not gitignored
for file in $(git diff --name-only --cached); do
    if [ -f "$file" ] && ! git check-ignore -q "$file"; then
        git add "$file"
    fi
done

# Step 3: Enforce Zero-Warning Policy (-Werror) and Spotless check
echo "🔍 Step 3/3: Enforcing Zero-Warning Policy & compilation..."
./gradlew spotlessCheck assembleDebug test --daemon -q

echo "=========================================================="
echo " ✅ [Pre-Commit Hook] Passed! Code is clean & zero-warning. "
echo "=========================================================="
echo ""
exit 0
